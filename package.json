{
  "name": "torquay-virtual-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:share": "npm run typecheck && vite build --mode share",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"tests/**/*.ts\" \"scripts/**/*.{mjs,mts}\" \"docs/asset-contract.md\" \"docs/milestones/**/*.md\" \"*.{js,ts,json,md,html}\"",
    "test": "vitest run",
    "generate:synthetic-heightfield": "node scripts/generate-synthetic-heightfield.mjs",
    "test:e2e:install": "playwright install chromium",
    "test:e2e": "playwright test",
    "test:e2e:tvw014:share": "playwright test --config=playwright.tvw014-share.config.ts",
    "test:e2e:tvw014:real": "playwright test --config=playwright.tvw014-real.config.ts",
    "test:e2e:tvw014:full": "playwright test --config=playwright.tvw014-full.config.ts",
    "test:e2e:tvw015:real": "npm run build && playwright test --config=playwright.tvw015-real.config.ts",
    "test:e2e:tvw015:share": "npm run build:share && playwright test --config=playwright.tvw015-share.config.ts",
    "test:e2e:overview:real": "npm run build && playwright test --config=playwright.overview-real.config.ts",
    "test:e2e:overview:share": "npm run build:share && playwright test --config=playwright.overview-share.config.ts",
    "test:e2e:torquay2km:real": "npm run build && playwright test --config=playwright.torquay2km-real.config.ts",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "dependencies": {
    "maplibre-gl": "6.15.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
